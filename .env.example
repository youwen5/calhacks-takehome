# Local defaults work without this file; pnpm dev and database scripts load it if present.
DATABASE_PATH=./data/portal.db
BETTER_AUTH_URL=http://localhost:5173
# Required in production: generate with `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Local default: outbox. VPS Compose uses disabled + explicit demo verification.
# Optional live email deployments can use ses.
MAIL_MODE=outbox
OUTBOX_DIR=./data/outbox
# Live SES: standard AWS credential chain (environment, profile, or IAM role).
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SES_FROM=
# Actual public HTTPS URL for adapter-node behind a trusted reverse proxy.
ORIGIN=
# Required when running adapter-node directly; the Nix entrypoint sets this too.
# 2 MiB PDF + 64 KiB form overhead; ordinary forms still enforce 64 KiB.
BODY_SIZE_LIMIT=2162688
# Demo only: allow signed-in users to mark their email verified from the banner.
# Defaults to enabled in development and disabled in production.
# Set true explicitly for a deployed demo, or false to require real verification locally.
# DEMO_EMAIL_VERIFICATION=true
