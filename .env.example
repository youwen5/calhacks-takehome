# Local defaults work without this file; pnpm dev and database scripts load it if present.
DATABASE_PATH=./data/portal.db
BETTER_AUTH_URL=http://localhost:5173
# Required in production: generate with `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Local default: outbox. Production requires ses.
MAIL_MODE=outbox
OUTBOX_DIR=./data/outbox
# Live SES: standard AWS credential chain (environment, profile, or IAM role).
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SES_FROM=
# Actual public HTTPS URL for adapter-node behind a trusted reverse proxy.
ORIGIN=
