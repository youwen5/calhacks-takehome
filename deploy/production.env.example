# Copy to .env.production in the Compose directory; never commit real secrets.
# Public HTTPS origin, no trailing slash or path.
BETTER_AUTH_URL=https://calhacks.youwen.dev
# Generate: openssl rand -hex 48
BETTER_AUTH_SECRET=
# Nix image loaded locally with Podman or Docker; no registry is required.
PORTAL_IMAGE=localhost/calhacks-portal:local
# Host loopback port forwarded by your HTTPS reverse proxy.
PORTAL_PORT=3000
